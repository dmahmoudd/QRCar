{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "QrCar.Api",
    "Audience": "QrCar.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "PasswordResetMinutes": 30
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "From": "noreply@tala3ny.app",
    "FromName": "Tala3ny"
  },
  "Security": {
    "EncryptionKey": "",
    "IpHashKey": ""
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200",
    "ScanPathTemplate": "/c/{token}",
    "AdditionalOrigins": ""
  },
  "PublicScan": {
    "CooldownMinutes": 3,
    "MaxRequestsPerCarPerDay": 10,
    "RequestLifetimeHours": 12,
    "MaxMessageLength": 250
  }
}
